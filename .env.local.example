# Supabase Storage
# Vercel's Supabase integration provides this variable automatically.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Optional alias supported by the API outside Vercel:
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Recommended for server-side uploads (storage writes + signed URLs)
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY="*****************************"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="************************************"
NEXT_PUBLIC_SUPABASE_URL="************************"
SUPABASE_POSTGRES_DATABASE="*****************"
SUPABASE_POSTGRES_HOST="*************"
SUPABASE_POSTGRES_PASSWORD="*****************"
SUPABASE_POSTGRES_PRISMA_URL="*******************"
SUPABASE_POSTGRES_URL="************"
SUPABASE_POSTGRES_URL_NON_POOLING="************************"
SUPABASE_POSTGRES_USER="*************"
SUPABASE_ANON_KEY="*****************"
SUPABASE_JWT_SECRET="*******************"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="************************"
SUPABASE_SECRET_KEY="*******************"
SUPABASE_SERVICE_ROLE_KEY="*************************"
NEXT_PUBLIC_SUPABASE_URL="************"

# Discord + Email
WEBHOOK_URL=https://discord.com/api/webhooks/...
RESEND_API_KEY=YOUR_RESEND_API_KEY

