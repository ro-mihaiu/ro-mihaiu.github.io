# Discord Webhook Configuration (RECOMMENDED FOR NOW)
# Create a webhook in your Discord server: Server Settings > Integrations > Webhooks > New Webhook
# Copy the URL and paste it here
WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# ===== ALTERNATIVE OPTIONS (Comment out WEBHOOK_URL if switching) =====

# Option 2: Resend Email Service (switch when ready)
# Sign up at https://resend.com (free tier available)
# Copy your API key from dashboard
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# Option 3: Gmail SMTP (traditional email)
# 1. Enable 2-factor authentication on your Google account
# 2. Create app password: myaccount.google.com > Security > App passwords
# 3. Generate password for "Mail" and "Windows Computer"
# 4. Paste the 16-character password below (no spaces)
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ===== OTHER CONFIGURATION =====

# Contact email (optional, for confirmation emails)
CONTACT_EMAIL=your-contact-email@gmail.com

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
